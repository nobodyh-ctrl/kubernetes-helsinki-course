<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="ingress-routing" name="Ingress routing">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="client" value="Browser / curl&lt;br&gt;localhost:8081" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="180" height="120" as="geometry" />
        </mxCell>
        <mxCell id="lb" value="k3d serverlb&lt;br&gt;8081 → 80" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="390" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="traefik" value="Traefik&lt;br&gt;ingress controller&lt;br&gt;kube-system" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="Ingress log-output-ingress&lt;br&gt;class: traefik · host: *&lt;br&gt;&lt;br&gt;/pingpong → ping-pong:2345&lt;br&gt;/ → log-output:2345" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=24;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="860" y="330" width="380" height="220" as="geometry" />
        </mxCell>
        <mxCell id="svc-log" value="Service log-output&lt;br&gt;ClusterIP · 2345" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="650" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="svc-ping" value="Service ping-pong&lt;br&gt;ClusterIP · 2345" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="650" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pod-log" value="Pod log-output&lt;br&gt;container :8000" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="640" y="820" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pod-ping" value="Pod ping-pong&lt;br&gt;container :8000" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="820" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Path matching&lt;br&gt;• Traefik evaluates the longest matching prefix first.&lt;br&gt;• /pingpong goes to ping-pong; / goes to log-output.&lt;br&gt;• Both Services are ClusterIP: only the Ingress is exposed.&lt;br&gt;• todo-app's Ingress is not applied in 1.9, so it does not compete for /." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="500" height="250" as="geometry" />
        </mxCell>
        <mxCell id="e-client-lb" value="HTTP :8081" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="client" target="lb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-lb-traefik" value=":80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="lb" target="traefik">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-traefik-ing" value="matches rules" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="traefik" target="ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ing-log" value="/" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ingress" target="svc-log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ing-ping" value="/pingpong" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.8;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="ingress" target="svc-ping">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-svc-log-pod" value="2345 → 8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc-log" target="pod-log">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-svc-ping-pod" value="2345 → 8000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="svc-ping" target="pod-ping">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
