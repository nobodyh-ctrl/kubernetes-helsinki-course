        <mxCell id="group-log" value="log-output (exercise 1.9)" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1420" height="480" as="geometry" />
        </mxCell>
        <mxCell id="dep-log" value="Deployment log-output&lt;br&gt;replicas: 1&lt;br&gt;selector: app=log-output" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rs-log" value="ReplicaSet log-output-594d74697d" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="250" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pod-log" value="Pod log-output-594d74697d-xq6tp&lt;br&gt;labels: app=log-output&lt;br&gt;containerPort: 8000" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="svc-log" value="Service log-output&lt;br&gt;ClusterIP · 10.43.61.228&lt;br&gt;port 2345 → targetPort 8000&lt;br&gt;selector: app=log-output" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="390" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note-log" value="The Service selector is the contract:&lt;br&gt;app=log-output must match the pod label.&lt;br&gt;&lt;br&gt;The Service does not create pods; it only&lt;br&gt;load-balances across the pods that match." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="400" height="230" as="geometry" />
        </mxCell>
        <mxCell id="group-ping" value="ping-pong (exercise 1.9)" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1420" height="480" as="geometry" />
        </mxCell>
        <mxCell id="dep-ping" value="Deployment ping-pong&lt;br&gt;replicas: 1&lt;br&gt;selector: app=ping-pong" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="rs-ping" value="ReplicaSet ping-pong-75488f8f7b" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="770" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pod-ping" value="Pod ping-pong-75488f8f7b-d92sd&lt;br&gt;labels: app=ping-pong&lt;br&gt;containerPort: 8000" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#ffffff;strokeColor=#82b366;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="910" width="360" height="120" as="geometry" />
        </mxCell>
        <mxCell id="svc-ping" value="Service ping-pong&lt;br&gt;ClusterIP · 10.43.239.249&lt;br&gt;port 2345 → targetPort 8000&lt;br&gt;selector: app=ping-pong" style="whiteSpace=wrap;html=1;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="910" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note-ping" value="The in-memory counter lives inside the pod.&lt;br&gt;If the pod is recreated, it starts at 0 again.&lt;br&gt;With more replicas, each pod has its own counter." style="whiteSpace=wrap;html=1;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1000" y="620" width="400" height="230" as="geometry" />
        </mxCell>
        <mxCell id="e-dep-rs-log" value="creates" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="dep-log" target="rs-log">
